+                state
+                    .workspace
+                    .open_file
+                    .set(Some(if styled { "suffix.rs" } else { "suffix.txt" }.into()));
+                if styled {
+                    EditorActions::new(state.workspace).install_syntax_transport(installed);
+                }
+                state.workspace.content.set(source.into());
