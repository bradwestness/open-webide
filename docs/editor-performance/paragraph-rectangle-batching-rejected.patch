+// A DOM primitive only: Rust supplies validated UTF-16 ranges and owns all
+// glyph selection, source identity, overlap and geometry acceptance policy.
+#[wasm_bindgen::prelude::wasm_bindgen(inline_js = r#"
+export function paragraph_range_rectangles(nodes, bounds, offsets) {
+    const locate = (offset) => {
+        let first = 0, last = nodes.length;
+        while (first < last) {
+            const middle = first + Math.floor((last - first) / 2);
+            if (bounds[middle * 2] + bounds[middle * 2 + 1] <= offset) first = middle + 1;
+            else last = middle;
+        }
+        const index = first < nodes.length ? first : nodes.length - 1;
+        if (index < 0) throw new Error('Missing text node');
+        const at = offset - bounds[index * 2];
+        if (at < 0 || at > bounds[index * 2 + 1]) throw new Error('Invalid text offset');
+        return [nodes[index], at];
+    };
+    const range = document.createRange();
+    const result = new Float64Array(offsets.length * 2);
+    for (let index = 0; index < offsets.length; index += 2) {
+        const start = locate(offsets[index]), end = locate(offsets[index + 1]);
+        range.setStart(start[0], start[1]);
+        range.setEnd(end[0], end[1]);
+        const rectangles = range.getClientRects();
+        let rectangle = null;
+        for (const candidate of rectangles) {
+            if (candidate.height > 0) { rectangle = candidate; break; }
+        }
+        if (!rectangle) throw new Error('Missing glyph rectangle');
+        const output = index * 2;
+        result[output] = rectangle.left;
+        result[output + 1] = rectangle.top;
+        result[output + 2] = rectangle.width;
+        result[output + 3] = rectangle.height;
+    }
+    return result;
+}
