+#[wasm_bindgen_test]
+async fn batched_paragraph_rectangles_preserve_scalar_dom_geometry_and_failures() {
+    use openwebide_core::editor::EditorFont;
+    use openwebide_frontend::components::batched_paragraph_rectangles_match_scalar;
+    let _fonts = load_all_editor_fonts().await;
+    let row = document().create_element("div").unwrap();
+    document().body().unwrap().append_child(&row).unwrap();
+    for font in EditorFont::ALL {
+        for features in ["normal", "'calt', 'liga'", "'calt' 0, 'liga' 0"] {
+            row.set_attribute("style", &format!("position:fixed;left:37.125px;top:14.25px;width:360px;font-family:'{}';font-size:13px;line-height:19.5px;font-feature-settings:{features};white-space:pre", font.name())).unwrap();
+            for body in [
+                "",
+                "a",
+                "alpha != -> beta",
+                "文😀 café á",
+                "אבג مرحبا x",
+                "x\t y  ",
+                "👨‍👩‍👧‍👦 flags 🇺🇸",
+            ] {
+                for nested in [false, true] {
+                    row.set_text_content(Some(body));
+                    if nested {
+                        row.set_text_content(None);
+                        for ch in body.chars() {
+                            let span = document().create_element("span").unwrap();
+                            span.set_attribute("style", "color:red").unwrap();
+                            span.set_text_content(Some(&ch.to_string()));
+                            row.append_child(&span).unwrap();
+                        }
+                        row.append_child(&document().create_text_node("")).unwrap();
+                    }
+                    let count = openwebide_core::editor::visual_line_offsets(body)
+                        .unwrap()
+                        .len()
+                        - 1;
+                    for origin in [0, 37] {
+                        let mut targets: Vec<_> = (origin..origin + count).collect();
+                        assert!(
+                            batched_paragraph_rectangles_match_scalar(&row, body, origin, &targets),
+                            "{font:?} {features} nested={nested}"
+                        );
+                        targets.reverse();
+                        targets.extend(targets.clone());
+                        assert!(batched_paragraph_rectangles_match_scalar(
+                            &row, body, origin, &targets
+                        ));
+                        assert!(batched_paragraph_rectangles_match_scalar(
+                            &row,
+                            body,
+                            origin,
+                            &[origin + count]
+                        ));
+                        assert!(batched_paragraph_rectangles_match_scalar(
+                            &row,
+                            body,
+                            origin,
+                            &[usize::MAX]
+                        ));
+                        assert!(batched_paragraph_rectangles_match_scalar(
+                            &row,
+                            "different source",
+                            origin,
+                            &targets
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    let body = row.text_content().unwrap();
+    row.remove();
+    assert!(batched_paragraph_rectangles_match_scalar(
+        &row,
+        &body,
+        0,
+        &[0]
+    ));
+}
