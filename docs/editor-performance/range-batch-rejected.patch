+#[wasm_bindgen::prelude::wasm_bindgen(inline_js = r#"
+export function editorProbeRectangles(nodes, positions) {
+    if (!nodes.length || positions.length % 4) throw new Error('Invalid range batch');
+    const range = nodes[0].ownerDocument.createRange();
+    const result = new Float64Array(positions.length);
+    for (let at = 0; at < positions.length; at += 4) {
+        range.setStart(nodes[positions[at]], positions[at + 1]);
+        range.setEnd(nodes[positions[at + 2]], positions[at + 3]);
+        const rectangles = range.getClientRects();
+        let rectangle;
+        for (let index = 0; index < rectangles.length; index++) {
+            const candidate = rectangles.item(index);
+            if (candidate && candidate.height > 0) { rectangle = candidate; break; }
+        }
+        if (!rectangle) throw new Error('Missing glyph rectangle');
+        result[at] = rectangle.left;
+        result[at + 1] = rectangle.top;
+        result[at + 2] = rectangle.width;
+        result[at + 3] = rectangle.height;
+    }
+    return result;
+}
