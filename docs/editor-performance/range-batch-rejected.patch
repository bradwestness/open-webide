+#[cfg(test)]
+mod rectangle_batch_tests {
+    use super::*;
+
+    #[wasm_bindgen_test::wasm_bindgen_test]
+    fn batched_ranges_match_every_scalar_glyph_and_reject_invalid_source_endpoints() {
+        let host = document().create_element("div").unwrap();
+        host.set_attribute("style", "font:13px monospace;white-space:pre")
+            .unwrap();
+        let row = document().create_element("span").unwrap();
+        row.set_inner_html("<span class=\"tok-string\">文😀é </span><span class=\"tok-comment\" style=\"font-style:italic\">words 👩‍👩‍👧‍👦 </span><span>\t🇺🇸 tail</span>");
+        host.append_child(&row).unwrap();
+        document().body().unwrap().append_child(&host).unwrap();
+        let body = row.text_content().unwrap();
+        let offsets = openwebide_core::editor::visual_line_offsets(&body).unwrap();
+        let targets = (0..offsets.len() - 1)
+            .map(|glyph| glyph + 500)
+            .collect::<Vec<_>>();
+        let measured = paragraph_rectangles(&row, &body, 500, &targets).unwrap();
+        let bounds = row.get_bounding_client_rect();
+        let nodes = TextNodes::new(&row).unwrap();
+        let range = document().create_range().unwrap();
+        for (local, result) in measured.iter().enumerate() {
+            let scalar =
+                range_rectangle(&range, &nodes, offsets[local].1, offsets[local + 1].1).unwrap();
+            assert_eq!(result.glyph, targets[local]);
+            assert_eq!(
+                result.left.to_bits(),
+                (scalar.left() - bounds.left()).to_bits()
+            );
+            assert_eq!(
+                result.top.to_bits(),
+                (scalar.top() - bounds.top()).to_bits()
+            );
+            assert_eq!(result.width.to_bits(), scalar.width().to_bits());
+            assert_eq!(result.height.to_bits(), scalar.height().to_bits());
+        }
+        assert!(paragraph_rectangles(&row, &body, 500, &[499]).is_none());
+        assert!(paragraph_rectangles(&row, &body, 500, &[500 + offsets.len() - 1]).is_none());
+        assert!(paragraph_rectangles(&row, "replacement", 500, &targets).is_none());
+        assert!(
+            paragraph_rectangles(&row, &body, 500, &[])
+                .unwrap()
+                .is_empty()
+        );
+        host.remove();
+    }
+}
